# WooCommerce Store Configuration (Required)
WOOCOMMERCE_URL=https://your-store.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret_here

# MCP Server Configuration (Optional)
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000

# Client Reliability Configuration (Optional)
WOOCOMMERCE_TIMEOUT_SECONDS=15.0
WOOCOMMERCE_MAX_RETRIES=3
WOOCOMMERCE_RETRY_BACKOFF_BASE=0.5
WOOCOMMERCE_RETRY_BACKOFF_MAX=10.0
